# 실제 키는 GitHub에 올리지 마세요. 이 파일을 .env로 복사해 로컬에만 입력합니다.
NHPLUG_APP_KEY=YOUR_APP_KEY
NHPLUG_APP_SECRET=YOUR_APP_SECRET
NHPLUG_BASE_URL=https://moapi.nhplug.com:8443
APP_MODE=paper
ENABLE_TRADING=false
ALLOWED_ORIGINS=https://ztman000-bot.github.io,http://localhost:8080,http://127.0.0.1:8080

# Safe Universe -> active focus. 068270은 보호종목으로 자동 대상에서 제외됩니다.
MASTER_PRESELECT=180
FOCUS_SIZE=40
PROTECTED_CODES=068270
POLL_SECONDS=2.0
AUTO_START_COLLECTOR=true
NH_REST_MIN_INTERVAL=0.28
QUOTE_MAX_AGE_SEC=180

# 대량 과거수집/백필은 장중 실시간 REST와 경쟁시키지 않습니다.
AUTO_BACKFILL=false
BACKFILL_COUNT=120

# v0.17.5 KR 1-minute Research Data Collector
# 장중: NH WebSocket KRX 체결(oc)로 우선/활성 최대 10종목의 1분 OHLCV를 만듭니다.
# 장후: 공식 기간별시세(gubun=5, xtick=1)로 1분봉을 보충합니다.
# 이 데이터는 연구 전용이며 실제 1분봉 Exit 재현 엔진이 검증되기 전에는 실전 승격 근거로 쓰지 않습니다.
KR_1M_RESEARCH_ENABLED=true
KR_1M_WS_ENABLED=true
KR_1M_LIVE_FOCUS=10
KR_1M_HISTORY_DAYS=30
KR_1M_HISTORY_CODES=40
KR_1M_ARRAY_COUNT=400
KR_1M_BACKFILL_INTERVAL_HOURS=12
KR_1M_WS_TIMEOUT_SEC=30

# v0.17.6 Scanner Intelligence / RVOL Data Build
# 이미 수집된 NH quote/5분봉 DB로 계산하므로 Scanner Intelligence 자체는 NH REST 호출을 추가하지 않습니다.
SCANNER_RVOL_LOOKBACK_DAYS=14
SCANNER_INTEL_SNAPSHOT_SEC=300
SCANNER_INTEL_TOP_N=20
SCANNER_INTEL_MIN_ATR_PCT=0.50
SCANNER_INTEL_MIN_RVOL=1.00
SCANNER_INTEL_MIN_TURNOVER_EOK=10
# 선택사항: OpenDART 공시 Catalyst를 함께 기록하려면 본인 키를 로컬 .env에만 입력하세요.
# OPENDART_API_KEY=YOUR_40_CHAR_KEY
DART_REFRESH_SEC=900

# v0.17.7 Decision Intelligence Shadow Layer
# 기존 Control/Scanner/Market 데이터를 재사용해 의사결정 메타데이터와 Risk Score를 기록합니다.
# Risk Score는 관찰/검증용이며 진입·청산·수량·실주문에 영향을 주지 않습니다.
DECISION_INTEL_SNAPSHOT_SEC=300
DECISION_INTEL_RETENTION_DAYS=180

# 미국시장은 데이터/연구부터 시작합니다. KR/US 통계와 DB는 분리합니다.
US_DATA_ENABLED=true
US_PAPER_ENABLED=false
US_REAL_ORDER_ENABLED=false
US_WATCHLIST=AAPL,NVDA,MSFT,AMD,AMZN,META,GOOGL,TSLA
US_POLL_SEC=3
US_CLOSED_POLL_SEC=300
US_REST_MIN_INTERVAL=0.30

# v0.17.4 US Research Data Collector
# 정규장 1분봉 -> 5분봉 집계, Point-in-Time Stocks-in-Play, Gap/RVOL/시장프록시 기록
US_RESEARCH_ENABLED=true
US_RESEARCH_PROXIES=SPY,QQQ,IWM
US_HISTORY_DAYS=60
US_LIVE_BAR_REFRESH_SEC=60
US_BACKFILL_INTERVAL_HOURS=12
US_PERIOD_COUNT=0480

# v0.17.11+ Remote Health Monitoring
# 기본 ntfy topic은 공기계에서 난수로 자동 생성됩니다. topic/status URL은 비밀번호처럼 취급하세요.
REMOTE_HEALTH_ENABLED=true
REMOTE_HEALTH_CHECK_SEC=30
REMOTE_HEALTH_HEARTBEAT_SEC=600
REMOTE_HEALTH_CHANGE_MIN_SEC=60
# REMOTE_HEALTH_WEBHOOK_URL=https://your-private-health-endpoint.example/heartbeat
# REMOTE_HEALTH_STATUS_URL=https://your-private-health-endpoint.example/status

# v0.17.12 Optional encrypted off-device DB backup — 기본 OFF.
# 외부 저장소를 준비한 뒤에만 true로 바꾸세요. HTTPS PUT만 허용합니다.
OFFSITE_BACKUP_ENABLED=false
# OFFSITE_BACKUP_PUT_URL=https://your-private-storage.example/backups/{filename}
# OFFSITE_BACKUP_BEARER_TOKEN=YOUR_PRIVATE_TOKEN
# 권장: passphrase를 .env에 직접 쓰기보다 0600 권한의 별도 파일을 지정합니다.
# OFFSITE_BACKUP_PASSPHRASE_FILE=/data/data/com.termux/files/home/.stock-trader-offsite-passphrase
# OFFSITE_BACKUP_PASSPHRASE=DO_NOT_COMMIT_REAL_SECRET
OFFSITE_BACKUP_PBKDF2_ITER=200000
OFFSITE_BACKUP_AFTER_MINUTE=960
