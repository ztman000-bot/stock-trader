# 실제 키는 GitHub에 올리지 마세요. 이 파일을 .env로 복사해 로컬에만 입력합니다.
NHPLUG_APP_KEY=YOUR_APP_KEY
NHPLUG_APP_SECRET=YOUR_APP_SECRET
NHPLUG_BASE_URL=https://moapi.nhplug.com:8443
APP_MODE=paper
ENABLE_TRADING=false
ALLOWED_ORIGINS=https://ztman000-bot.github.io,http://localhost:8080,http://127.0.0.1:8080

# Safe Universe -> active focus. 068270은 보호종목으로 자동 대상에서 제외됩니다.
MASTER_PRESELECT=180
FOCUS_SIZE=40
PROTECTED_CODES=068270
POLL_SECONDS=2.0
AUTO_START_COLLECTOR=true
NH_REST_MIN_INTERVAL=0.28
QUOTE_MAX_AGE_SEC=180

# 대량 과거수집/백필은 장중 실시간 REST와 경쟁시키지 않습니다.
AUTO_BACKFILL=false
BACKFILL_COUNT=120

# v0.17.5 KR 1-minute Research Data Collector
# 장중: NH WebSocket KRX 체결(oc)로 우선/활성 최대 10종목의 1분 OHLCV를 만듭니다.
# 장후: 공식 기간별시세(gubun=5, xtick=1)로 1분봉을 보충합니다.
# 이 데이터는 연구 전용이며 실제 1분봉 Exit 재현 엔진이 검증되기 전에는 실전 승격 근거로 쓰지 않습니다.
KR_1M_RESEARCH_ENABLED=true
KR_1M_WS_ENABLED=true
KR_1M_LIVE_FOCUS=10
KR_1M_HISTORY_DAYS=30
KR_1M_HISTORY_CODES=40
KR_1M_ARRAY_COUNT=400
KR_1M_BACKFILL_INTERVAL_HOURS=12
KR_1M_WS_TIMEOUT_SEC=30

# 미국시장은 데이터/연구부터 시작합니다. KR/US 통계와 DB는 분리합니다.
US_DATA_ENABLED=true
US_PAPER_ENABLED=false
US_REAL_ORDER_ENABLED=false
US_WATCHLIST=AAPL,NVDA,MSFT,AMD,AMZN,META,GOOGL,TSLA
US_POLL_SEC=3
US_CLOSED_POLL_SEC=300
US_REST_MIN_INTERVAL=0.30

# v0.17.4 US Research Data Collector
# 정규장 1분봉 -> 5분봉 집계, Point-in-Time Stocks-in-Play, Gap/RVOL/시장프록시 기록
US_RESEARCH_ENABLED=true
US_RESEARCH_PROXIES=SPY,QQQ,IWM
US_HISTORY_DAYS=60
US_LIVE_BAR_REFRESH_SEC=60
US_BACKFILL_INTERVAL_HOURS=12
US_PERIOD_COUNT=0480
